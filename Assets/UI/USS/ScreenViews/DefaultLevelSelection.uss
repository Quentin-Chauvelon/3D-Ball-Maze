.unity-scroll-view__content-container {
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: center;
}

#default-level-selection__levels-container .default-level-selection__page {
    position: absolute;
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

#default-level-selection__levels-container-scroll-view #unity-content-container {
    justify-content: space-around;
}

.level-selection-item-locked #default-level-selection-template__container-button {
    display: none;
}

.level-selection-item-unlocked #default-level-selection-template__lock-container {
    display: none;
}


/* Animate unlocked level hover */

.level-selection-item-unlocked #default-level-selection-template__container-button {
    transition: scale 0.1s ease-in-out-sine, rotate 0.1s ease-in-out-sine;
}

.level-selection-item-unlocked #default-level-selection-template__container-button:hover {
    scale: 1.05;
    rotate: 5deg;
}

.level-selection-item-unlocked #default-level-selection-template__container-button:active {
    scale: 0.95;
    rotate: 5deg;
}


/* Animate page arrow buttons hover */

#default-level-selection__levels-zone-container .page-arrow-button {
    transition: scale 0.1s ease-in-out-sine;    
}

#default-level-selection__levels-zone-container .page-arrow-button:hover {
    scale: 1.05;
    background-color: red;
}

#default-level-selection__levels-zone-container .page-arrow-button:active {
    scale: 0.95;
}