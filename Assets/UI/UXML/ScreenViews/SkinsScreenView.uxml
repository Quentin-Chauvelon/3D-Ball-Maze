<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SkinItemTemplate" src="project://database/Assets/UI/UXML/Templates/SkinItemTemplate.uxml?fileID=9197481963319205126&amp;guid=2c60857c286462a31bb87335cc5899fe&amp;type=3#SkinItemTemplate" />
    <Style src="project://database/Assets/UI/USS/ScreenViews/Skins.uss?fileID=7433441132597879392&amp;guid=0268325775cb194cd97b0f211a943312&amp;type=3#Skins" />
    <ui:VisualElement name="skins__background" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="skins__main-container" style="flex-grow: 1;">
            <ui:ScrollView name="skins__categories-container" mode="Horizontal" view-data-key="skins__categories-container" horizontal-scroller-visibility="Hidden" style="width: 100%; height: 10%; margin-bottom: 2%; mouse-wheel-scroll-size: 200;">
                <BallMaze.UI.MainTextButton name="skins__category-common" type="Secondary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="15" padding-left-right="15" text="COMMON" aspect-ratio-x="350" aspect-ratio-y="100" class="skins__category-item ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="flex-grow: 0; flex-shrink: 0; height: 100%; width: 100%; background-color: rgba(0, 0, 0, 0);" />
                <BallMaze.UI.MainTextButton name="skins__category-rare" type="Secondary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="15" padding-left-right="15" text="RARE" aspect-ratio-x="250" aspect-ratio-y="100" class="skins__category-item ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="flex-grow: 0; flex-shrink: 0; height: 100%; width: 100%; background-color: rgba(0, 0, 0, 0);" />
                <BallMaze.UI.MainTextButton name="skins__category-epic" type="Secondary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="15" padding-left-right="15" text="EPIC" aspect-ratio-x="250" aspect-ratio-y="100" class="skins__category-item ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="flex-grow: 0; flex-shrink: 0; height: 100%; width: 100%; background-color: rgba(0, 0, 0, 0);" />
                <BallMaze.UI.MainTextButton name="skins__category-unique" type="Secondary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="15" padding-left-right="15" text="UNIQUE" aspect-ratio-x="350" aspect-ratio-y="100" class="skins__category-item ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="flex-grow: 0; flex-shrink: 0; height: 100%; width: 100%; background-color: rgba(0, 0, 0, 0);" />
            </ui:ScrollView>
            <ui:ScrollView name="skins__skins-vertical-container" mode="VerticalAndHorizontal" horizontal-page-size="5" vertical-page-size="-1" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" style="flex-direction: row; justify-content: flex-start; align-items: stretch; flex-grow: 1; padding-right: 0;">
                <ui:VisualElement name="skins__skins-horizontal-container" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: center; max-width: 1200px; padding: 2%;" />
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="skins__separator" style="flex-grow: 0; width: 5px; background-color: rgb(47, 47, 47); margin: 0 3%;" />
        <ui:VisualElement name="skins__preview-container" style="flex-grow: 1; min-width: 35%; max-width: 35%; align-items: center; padding-bottom: 2%; margin-right: 3%;">
            <ui:VisualElement name="skins__preview-image" style="flex-grow: 1; align-self: stretch; margin: 5% 0; justify-content: center; align-items: center; background-image: url(&apos;project://database/Assets/Art/Skins/SkinPreview.renderTexture?fileID=8400000&amp;guid=7bc990da5937ebb41a44ba693d83f48a&amp;type=2#SkinPreview&apos;); -unity-background-scale-mode: scale-to-fit;">
                <ui:Label tabindex="-1" text="Loading..." enable-rich-text="false" parse-escape-sequences="true" display-tooltip-when-elided="true" name="skins__skin-texture-loading-label" style="display: none; -unity-font-style: bold; font-size: 50px; color: rgb(255, 255, 255);" />
                <ui:Label tabindex="-1" text="Couldn&apos;t load skin..." enable-rich-text="false" parse-escape-sequences="true" display-tooltip-when-elided="true" name="skins__skin-texture-loading-error-label" style="display: none; -unity-font-style: bold; font-size: 50px; color: rgb(255, 255, 255);" />
            </ui:VisualElement>
            <BallMaze.UI.MainTextButton name="skins__buy-button" type="Primary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFF" outline-width="2" outline-color="#3F3705" padding-top-bottom="15" padding-left-right="80" text="BUY" aspect-ratio-x="250" aspect-ratio-y="100" class="skins__skin-call-to-action ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="min-width: 50%; max-width: 50%; min-height: 14%; max-height: 14%; font-size: 50px; background-color: transparent" />
            <BallMaze.UI.MainTextButton name="skins__equip-button" type="Secondary" shape="Rectangle" border-size="TwoPointFive" text-color="#FFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="5" padding-left-right="5" text="EQUIP" aspect-ratio-x="250" aspect-ratio-y="100" class="skins__skin-call-to-action ah__scale-1-05 ah__rotate-5 aa__scale-0.95 aa__rotate-5 a__scale-0-1-ease-io-sine a__rotate-0-1-ease-io-sine" style="min-width: 50%; max-width: 50%; min-height: 14%; max-height: 14%; font-size: 50px; background-color: transparent" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
