<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/ModalViews/UncloseableModalViews/LevelFailed.uss?fileID=7433441132597879392&amp;guid=9d72becac3116de2482b15f797503bc7&amp;type=3#LevelFailed" />
    <BallMaze.UI.AspectRatio aspect-ratio-x="1" aspect-ratio-y="1" name="level-failed__aspect-ratio-container" class="default-levels" style="align-items: center; flex-grow: 0; background-color: rgb(255, 255, 255); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 100%; height: 100%; justify-content: space-around; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(101, 82, 0); border-right-color: rgb(101, 82, 0); border-top-color: rgb(101, 82, 0); border-bottom-color: rgb(101, 82, 0);">
        <ui:VisualElement name="level-failed__title-container" style="flex-grow: 1; position: absolute; top: 1%; width: 90%; background-color: rgba(255, 255, 255, 0); padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; margin-left: 15%; margin-right: 0; margin-top: -10%; background-image: url(&apos;project://database/Assets/UI/Textures/Common/Ribbon.png?fileID=2800000&amp;guid=18abacef44949424384ada83215164ed&amp;type=3#Ribbon&apos;); height: 20%;">
            <ui:Label tabindex="-1" text="LEVEL FAILED" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__title" style="flex-grow: 0; margin-top: 3%; -unity-text-align: middle-center; font-size: 60px; color: white; -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(63, 55, 5); text-shadow: 5 10 0 rgb(63, 55, 5);" />
        </ui:VisualElement>
        <ui:Label tabindex="-1" text="Try again?" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__level-failed-label" style="margin-top: 14%; -unity-text-align: middle-center; font-size: 50px; color: rgb(255, 226, 98); -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(63, 55, 5); text-shadow: 5 10 0 rgb(63, 55, 5);" />
        <ui:VisualElement name="level-failed__restart-where-you-failed-container" style="display: none; flex-grow: 0; width: 100%; align-items: center; justify-content: space-between;">
            <ui:VisualElement name="level-failed__restart-where-you-failed-methods-container" style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; width: 100%;">
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__restart-where-you-failed-coins-button" enable-rich-text="false" style="width: 30%; min-width: auto; min-height: auto; flex-direction: row; margin-right: 5%;">
                    <ui:VisualElement name="level-failed__restart-where-you-failed-coins-button-coin-image" style="flex-grow: 0; width: 30%; height: 100%; background-image: url(&apos;project://database/Assets/Joystick%20Pack/Sprites/All%20Axis%20Backgrounds/AllAxis_Ridged.png?fileID=2800000&amp;guid=54628aafa20f64b40ae661038ee7abf0&amp;type=3#AllAxis_Ridged&apos;); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0;" />
                    <ui:Label tabindex="-1" text="1234" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__restart-where-you-failed-coins-button-cost-label" enable-rich-text="false" style="width: 60%; -unity-text-align: middle-left; font-size: 40px; -unity-font-style: bold; margin-left: 5%;" />
                </ui:Button>
                <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__restart-where-you-failed-ad-button" enable-rich-text="false" style="width: 30%; min-width: auto; min-height: auto; flex-direction: row; margin-left: 5%;">
                    <ui:VisualElement name="level-failed__restart-where-you-failed-ad-button-ad-image" style="flex-grow: 0; width: 30%; height: 100%; background-image: url(&apos;project://database/Assets/Joystick%20Pack/Sprites/All%20Axis%20Backgrounds/AllAxis_Ridged.png?fileID=2800000&amp;guid=54628aafa20f64b40ae661038ee7abf0&amp;type=3#AllAxis_Ridged&apos;); -unity-background-scale-mode: scale-to-fit; flex-shrink: 0;" />
                    <ui:Label tabindex="-1" text="AD" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__restart-where-you-failed-ad-button-ad-label" enable-rich-text="false" style="width: 60%; -unity-text-align: middle-left; font-size: 40px; -unity-font-style: bold; margin-left: 5%;" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Button parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__unlimited-restarts-iap-button" enable-rich-text="false" style="width: 80%; min-width: auto; min-height: auto; flex-direction: row; margin-top: 3%;">
                <ui:Label tabindex="-1" text="UNLIMITED RESTARTS" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-failed__unlimited-restarts-iap-button-label" enable-rich-text="false" style="width: 100%; -unity-text-align: middle-center; font-size: 40px; -unity-font-style: bold;" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="level-failed__sad-ball-container" style="flex-grow: 1; width: 100%; margin: 5%; margin-bottom: 0;">
            <ui:VisualElement name="level-failed__sad-ball" style="width: 100%; height: 100%; color: rgb(255, 0, 0); -unity-background-scale-mode: scale-to-fit; background-image: url(&apos;project://database/Assets/UI/Textures/Level_Failed/Sad_Ball.png?fileID=2800000&amp;guid=9c2838094a113724694868030195ce9f&amp;type=3#Sad_Ball&apos;); -unity-background-image-tint-color: rgb(229, 229, 229);" />
        </ui:VisualElement>
        <ui:VisualElement name="level-failed__buttons-container" style="flex-grow: 0; width: 100%; justify-content: space-around; align-items: center; margin-bottom: 5%; height: 28%;">
            <BallMaze.UI.MainImageButton name="level-failed__default-levels-list-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="45" icon="UI/Icons/Levels_List" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="45" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto;" />
            <BallMaze.UI.MainImageButton name="level-failed__home-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="40" icon="UI/Icons/Home2" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="40" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="display: none; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto;" />
            <BallMaze.UI.RadialProgress name="level-failed__try-again-radial-progress" progress="100" style="align-self: auto; flex-grow: 0; margin-top: auto; align-items: center; justify-content: center; flex-direction: column; flex-wrap: nowrap; width: 28%;">
                <BallMaze.UI.MainImageButton name="level-failed__try-again-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="30" icon="UI/Icons/Try_Again" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="30" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="width: 97%; height: 97%; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto; -unity-background-scale-mode: scale-to-fit;" />
            </BallMaze.UI.RadialProgress>
        </ui:VisualElement>
    </BallMaze.UI.AspectRatio>
</ui:UXML>
