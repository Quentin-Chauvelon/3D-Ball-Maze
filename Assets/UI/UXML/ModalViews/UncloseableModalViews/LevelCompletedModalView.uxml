<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/USS/ModalViews/UncloseableModalViews/LevelCompleted.uss?fileID=7433441132597879392&amp;guid=1e699a449ee3fe753b20c74f0b31e559&amp;type=3#LevelCompleted" />
    <Style src="project://database/Assets/UI/USS/Star.uss?fileID=7433441132597879392&amp;guid=be443f08b8be40221aae9c67904ad562&amp;type=3#Star" />
    <BallMaze.UI.AspectRatio aspect-ratio-x="1" aspect-ratio-y="1" name="level-completed__aspect-ratio-container" class="default-levels" style="align-items: center; justify-content: space-around; flex-grow: 0; background-color: rgb(255, 255, 255); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 100%; height: 100%; border-top-width: 10px; border-right-width: 10px; border-bottom-width: 10px; border-left-width: 10px; border-left-color: rgb(101, 82, 0); border-right-color: rgb(101, 82, 0); border-top-color: rgb(101, 82, 0); border-bottom-color: rgb(101, 82, 0);">
        <ui:VisualElement name="level-completed__title-container" style="flex-grow: 1; position: absolute; top: 1%; width: 95%; background-color: rgba(255, 255, 255, 0); padding-top: 1%; padding-right: 1%; padding-bottom: 1%; padding-left: 1%; margin-left: 15%; margin-right: 0; margin-top: -10%; background-image: url(&apos;project://database/Assets/UI/Textures/Common/Ribbon.png?fileID=2800000&amp;guid=18abacef44949424384ada83215164ed&amp;type=3#Ribbon&apos;); height: 20%;">
            <ui:Label tabindex="-1" text="LEVEL COMPLETED" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-completed__title" style="flex-grow: 0; margin-top: 3%; -unity-text-align: middle-center; font-size: 50px; color: white; -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(63, 55, 5); text-shadow: 5 10 0 rgb(63, 55, 5);" />
        </ui:VisualElement>
        <ui:VisualElement name="level-completed__stars-and-coins-container" style="flex-grow: 1; margin-top: 15%; flex-direction: column; width: 80%; justify-content: space-between; align-items: center;">
            <ui:VisualElement name="level-completed__stars-container" style="flex-grow: 1; width: 100%; flex-direction: row; justify-content: center; align-items: flex-end; margin-bottom: 0;">
                <ui:VisualElement name="level-completed__star-1" class="star" style="flex-grow: 0; -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement name="level-completed__star-2" class="star" style="flex-grow: 0; -unity-background-scale-mode: scale-to-fit;" />
                <ui:VisualElement name="level-completed__star-3" class="star" style="flex-grow: 0; -unity-background-scale-mode: scale-to-fit;" />
            </ui:VisualElement>
            <ui:VisualElement name="level-completed__coins-double-iap-container" style="flex-grow: 0; justify-content: center; align-items: center; width: 100%;">
                <ui:VisualElement name="level-completed__coins-double-container" class="coins-not-doubled" style="flex-grow: 0; flex-direction: row; align-items: center; justify-content: center; width: 60%;">
                    <ui:VisualElement name="level-completed__coins-earned-container" style="flex-grow: 1; flex-direction: row; justify-content: center; align-items: center; width: 40%; margin-right: 0;">
                        <ui:Label name="level-completed__coins-earned-label" tabindex="-1" text="0" parse-escape-sequences="true" display-tooltip-when-elided="true" style="height: 100%; -unity-text-align: middle-right; font-size: 50px; -unity-font-style: bold;" />
                        <ui:VisualElement name="level-completed__coins-earned-coin-image" style="width: 23%; height: 100%; background-image: url(&apos;project://database/Assets/UI/Textures/Common/Coin_Border.png?fileID=2800000&amp;guid=f6c253b4572ea3c4c958de546b74fd1a&amp;type=3#Coin_Border&apos;); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 221, 0); margin-left: 3%; margin-right: -3%;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="level-completed__times-info-container" style="flex-shrink: 0; flex-grow: 0; margin-top: 3%; margin-bottom: 3%;">
            <ui:Label tabindex="-1" text="TIME: 00:00s" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-completed__time-label" style="-unity-text-align: middle-center; font-size: 35px; color: rgb(255, 226, 98); -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(63, 55, 5); text-shadow: 5 10 0 rgb(63, 55, 5);" />
            <ui:Label tabindex="-1" text="BEST TIME: 00:00s" parse-escape-sequences="true" display-tooltip-when-elided="true" name="level-completed__second-time-info-label" style="-unity-text-align: middle-center; font-size: 35px; color: rgb(255, 226, 98); -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(63, 55, 5); text-shadow: 5 10 0 rgb(63, 55, 5);" />
        </ui:VisualElement>
        <ui:VisualElement name="level-completed__buttons-container" style="flex-shrink: 0; flex-grow: 0; flex-direction: row; align-items: flex-end; justify-content: center; margin-bottom: 5%;">
            <BallMaze.UI.MainImageButton name="level-completed__default-levels-list-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="35" icon="UI/Icons/Levels_List" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="35" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="width: 20%; height: 70%; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto;" />
            <BallMaze.UI.MainImageButton name="level-completed__home-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="40" icon="UI/Icons/Home2" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="40" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="width: 20%; height: 70%; display: none; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto;" />
            <BallMaze.UI.MainImageButton name="level-completed__next-level-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="35" icon="UI/Icons/Skip" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="35" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="width: 20%; height: 70%; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0 6%; padding: 0; align-self: flex-start; -unity-background-scale-mode: scale-to-fit;" />
            <BallMaze.UI.MainImageButton name="level-completed__try-again-button" type="Primary" shape="Cricle" border-size="TwoPointFive" text-color="#FFFFFFFF" outline-width="2" outline-color="#003d70" padding-top-bottom="25" icon="UI/Icons/Try_Again" aspect-ratio-x="1" aspect-ratio-y="1" padding-left-right="25" class="ah__scale-1-05 aa__scale-0.95 a__scale-0-1-ease-io-sine" style="width: 20%; height: 70%; display: flex; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; background-color: rgba(188, 188, 188, 0); border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin: 0; padding: 0; align-self: auto; -unity-background-scale-mode: scale-to-fit;" />
        </ui:VisualElement>
        <ui:VisualElement name="level-completed__new-best-time" style="position: absolute; justify-content: center; align-items: center; width: 35%; height: 20%; background-color: rgba(255, 255, 255, 0); top: 55%; right: -13%; rotate: 30deg; background-image: url(&apos;project://database/Assets/UI/Textures/Common/Explosion.png?fileID=2800000&amp;guid=6fe3e5b3b1c86044a9e245e03509ed18&amp;type=3#Explosion&apos;); -unity-background-image-tint-color: rgb(217, 0, 0); -unity-background-scale-mode: stretch-to-fill;">
            <ui:Label tabindex="-1" text="NEW\nBEST!" parse-escape-sequences="true" display-tooltip-when-elided="true" style="-unity-text-align: middle-center; font-size: 40px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font: url(&apos;project://database/Assets/UI/Fonts/Halo%20Dek.ttf?fileID=12800000&amp;guid=7b68df16516b4bc72b94b479a3d2baf0&amp;type=3#Halo Dek&apos;); -unity-font-definition: initial; -unity-text-outline-width: 2; -unity-text-outline-color: rgb(100, 0, 0); text-shadow: 5 10 0 rgb(150, 0, 0);" />
        </ui:VisualElement>
    </BallMaze.UI.AspectRatio>
</ui:UXML>
